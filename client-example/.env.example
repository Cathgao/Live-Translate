# Copy this file to .env and adjust values for your setup.
# All variables are optional — the client will fall back to safe defaults.

# --- Server connection ---
LIVE_TRANSLATE_HOST=your-server.example.com
LIVE_TRANSLATE_PORT=443
LIVE_TRANSLATE_SECURE=true
LIVE_TRANSLATE_TOKEN=

# --- Language pair ---
LIVE_TRANSLATE_SOURCE=Auto
LIVE_TRANSLATE_TARGET=Chinese (Simplified)
LIVE_TRANSLATE_SILENCE_MS=1000

# --- ffmpeg ---
# Leave blank to auto-detect from PATH / common install locations.
# Examples:
#   Windows:  LIVE_TRANSLATE_FFMPEG="C:\ffmpeg\bin\ffmpeg.exe"
#   macOS:    LIVE_TRANSLATE_FFMPEG=/opt/homebrew/bin/ffmpeg
LIVE_TRANSLATE_FFMPEG=

# --- Microphone selection (optional) ---
# EASIEST: paste the EXACT name shown by `ffmpeg -list_devices true -f dshow -i dummy`.
# Example (Chinese Windows):
#   LIVE_TRANSLATE_MIC="麦克风 (Realtek High Definition Audio)"
#
# Or use a numeric index after running the picker once:
#   LIVE_TRANSLATE_MIC=1
#
# Leave blank to scan + interactively pick from available microphones at startup.
LIVE_TRANSLATE_MIC=

# --- Audio source (optional) ---
LIVE_TRANSLATE_SOURCE_MODE=mic
LIVE_TRANSLATE_FILE=