# Copy this file to .env and fill in your own values.
# Required: Gemini API key for the Live Translate backend.
GEMINI_API_KEY=

# Server listening address and port.
# The app listens on 0.0.0.0 in server.ts, and PORT is read from the environment.
HOST=0.0.0.0
PORT=3000

# Hostname(s) allowed to access the Vite dev server.
# Use a single host or a comma-separated list. These are passed to
# vite.config.ts `server.allowedHosts` so reverse-proxied domain access
# (e.g. via nginx) is not blocked by Vite's host check.
ALLOWHOST=

# Optional shared-secret token for external clients connecting to /live.
# Leave empty to disable token verification (default; Web browsers unaffected).
# When set, clients must connect to /live with ?token=... matching this value.
# Example: CLIENT_AUTH_TOKEN=please-change-me
CLIENT_AUTH_TOKEN=
