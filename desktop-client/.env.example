# WebSocket endpoint for the Live Translate server.
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
#
# Format: wss://<host>[:port]/<path>
# - Port 443 is the standard TLS port and can usually be omitted.
# - The path must end with `/live` (or whatever your server exposes).
VITE_WS_URL=wss://your-server.example.com:443/live
